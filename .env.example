# ========================================================
# Agentify Environment Variables
# Copy these into your Railway Project Variables settings
# ========================================================

# --- AI Provider Keys ---
# Groq API Keys (Primary provider - multi-key rotation supported)
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Google Gemini API Keys (Fallback provider)
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Persistent Storage (Required on Railway) ---
# If you attach a Railway Volume (e.g. mounted at /app/data):
# DATA_DIR=/app/data
# DB_PATH=/app/data/clinic.sqlite
# SESSIONS_DIR=/app/data/sessions

# --- Auth & Sessions ---
# Secret used to blind server-side session tokens (set a long random string)
SESSION_SECRET=

# Admin panel password (defaults to server-side fallback if unset)
ADMIN_PASSWORD=

# Optional: scrypt$ hash of the admin password for stronger storage
# ADMIN_PASSWORD_HASH=

# --- Google Sheets Integration (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
