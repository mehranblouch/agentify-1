# ========================================================
# Agentify Environment Variables
# Copy these into your Railway Project Variables settings
# ========================================================

# --- AI Provider Keys ---
# Groq API Keys (Primary provider - multi-key rotation supported)
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Google Gemini API Keys (Fallback provider)
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Persistent Storage (Optional on Railway Volume) ---
# If you attach a Railway Volume (e.g. mounted at /app/data):
# DATA_DIR=/app/data
# SESSIONS_DIR=/app/data/sessions

# --- Google Sheets Integration (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
